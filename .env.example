# ============ ParaBank 测试环境配置模板 ============
# 复制本文件为 .env 并按实际环境填写

# API 服务地址
API_BASE_URL=http://localhost:8080/parabank

# UI 页面地址
UI_BASE_URL=http://localhost:8080/parabank

# ParaBank 默认测试账号（公开演示账号，无需修改）
TEST_USERNAME=john
TEST_PASSWORD=demo

# ============ 以下配置 ParaBank 不使用，保留作为扩展位 ============
# 数据库配置（ParaBank 使用内嵌 HSQLDB，无需外部数据库）
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=credit_test
# DB_USER=<your_db_user>
# DB_PWD=<your_db_password>

# ============ 数据清理开关 ============
# 设为 0 可跳过 pytest session 前后的自动清理（调试用）
PARABANK_CLEANUP=1
