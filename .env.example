# ============================================================
# ParaBank 测试环境配置模板
# ============================================================
# 使用方法：
#   1. 复制本文件为 .env
#   2. 按实际环境修改（本地默认值通常无需改动）
#   3. .env 已被 .gitignore 忽略，不会被提交
# ============================================================

# ============ 服务地址 ============
API_BASE_URL=http://localhost:8080/parabank
UI_BASE_URL=http://localhost:8080/parabank

# ============ 测试账号 ============
TEST_USERNAME=john
TEST_PASSWORD=demo

# ============ 数据清理开关 ============
PARABANK_CLEANUP=1